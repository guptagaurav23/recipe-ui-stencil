{
  "name": "@gauravgupta14/recipe-ui",
  "version": "0.0.2",
  "description": "Reusable Stencil UI component library for Recipe Finder & Meal Planner",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/recipie-ui/recipie-ui.esm.js",
  "exports": {
    ".": {
      "import": "./dist/recipie-ui/recipie-ui.esm.js",
      "require": "./dist/recipie-ui/recipie-ui.cjs.js"
    },
    "./recipe-card": {
      "import": "./dist/components/recipe-card.js",
      "types": "./dist/components/recipe-card.d.ts"
    },
    "./rating-star": {
      "import": "./dist/components/rating-star.js",
      "types": "./dist/components/rating-star.d.ts"
    },
    "./day-planner": {
      "import": "./dist/components/day-planner.js",
      "types": "./dist/components/day-planner.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate"
  },
  "devDependencies": {
    "@stencil/core": "^4.27.1 || ^5.0.0-0",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "playwright": "^1.52.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "bootstrap": "^5.3.8"
  }
}